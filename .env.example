# Dipperfox Carrier Generator — environment variables.
# Set these on the Railway service (Variables tab). Never commit real values.

# --- Required ---------------------------------------------------------------
# Reference to the Railway PostgreSQL service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# development | test | production. "test" shows the test-environment banner.
APP_ENV=test

# Random secret (32+ bytes) used to hash session tokens and sign the admin cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- AI research (Anthropic) --------------------------------------------------
# Without this key, AI parsing/research/questions are disabled; manual entry still works.
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_RESEARCH=claude-sonnet-5-5
# App-side daily AI spend ceiling in USD (the Anthropic Console limit is the hard backstop).
AI_DAILY_BUDGET_USD=0.30
AI_MAX_SEARCHES_PER_RESEARCH=5
MAX_ASSESSMENTS_PER_VISITOR_PER_DAY=5
MAX_QUESTIONS_PER_ASSESSMENT=5
RESEARCH_REFRESH_DAYS=180

# --- Admin (/admin enquiries list + CSV exports) ------------------------------
# Set this yourself in the Railway dashboard; never share it in chat.
ADMIN_PASSWORD=
